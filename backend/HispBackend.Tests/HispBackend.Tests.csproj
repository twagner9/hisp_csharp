<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
	<IsPackable>false</IsPackable>
	<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>
	
	<PropertyGroup>
		<NativeSourceDir Condition="'$(NativeBuildDir)' == ''">../../native</NativeSourceDir>
		<NativeBuildDir Condition="'$(NativeBuildDir)' == ''">../../build</NativeBuildDir>
		<CMakeExe>cmake</CMakeExe>
	</PropertyGroup>
	<PropertyGroup>
		<VsBundledCMake>$(VSINSTALLDIR)Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe</VsBundledCMake>
		<CMakeExe Condition="'$(VSINSTALLDIR)' != '' And Exists('$(VsBundledCMake)')">$(VsBundledCMake)</CMakeExe>
	</PropertyGroup>
	
	<Target Name="RunCMake" BeforeTargets="BeforeBuild" Condition="'$SKipNativeBuild)' != 'true'">
		<!-- Linux config generator -->
		<Exec Condition="$([MSBuild]::IsOSPlatform('Linux'))" Command="'$(CMakeExe)' -S '$(NativeSourceDir)' -B '$(NativeBuildDir)' -DCMAKE_BUILD_TYPE=$(Configuration)" />
		<Exec Condition="$([MSBuild]::IsOSPlatform('Linux'))" Command="'$(CMakeExe)' --build '$(NativeBuildDir)' --parallel"/>
		
		<!-- Windows: Visual Studio generator -->
		<Exec Condition="$([MSBuild]::IsOSPlatform('Windows'))" Command="'$(CMakeExe)' --build '$(NativeBuildDir)' --config $(Configuration)"/>
		<Exec Condition="$([MSBuild]::IsOSPlatform('Windows'))" Command="'$(CMakeExe)' -S '$(NativeSourceDir) -B '$(NativeBuildDir)' -A x64"/>
	</Target>

	<ItemGroup>
		<PackageReference Include="coverlet.collector" Version="6.0.4" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
		<PackageReference Include="xunit" Version="2.9.3" />
		<PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Xunit" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\HispBackend\HispBackend.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="TestData/tiny_flowers.jpg">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="TestData/gaussian_tiny_flowers.jpg">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
	<ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
		<None Include="../../build/libHISPImageProcessing.so" Link="libHISPImageProcessing.so" CopyToOutputDirectory="PreserveNewest"/>
	</ItemGroup>
	<ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
		<None Include="../../build/HISPImageProcessing.dll" Link="HISPImageProcessing.dll" CopyToOutputDirectory="PreserveNewest"/>
	</ItemGroup>
</Project>