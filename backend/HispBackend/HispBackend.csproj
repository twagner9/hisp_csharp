<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

	<PropertyGroup>
		<NativeSourceDir Condition="'$(NativeSourceDir)' == ''">$(MSBuildProjectDirectory)/../HISP</NativeSourceDir>
		<NativeBuildDir Condition="'$(NativeBuildDir)' == ''">$(NativeSourceDir)</NativeBuildDir>
		<CMakeExe>cmake</CMakeExe>
	</PropertyGroup>
	<PropertyGroup>
		<CMakeExe>cmake</CMakeExe>
		<VsBundledCMake>$([System.IO.Path]::GetFullPath('$(MSBuildExtensionsPath)\..\Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe'))</VsBundledCMake>
		<CMakeExe Condition="Exists('$(VsBundledCMake)')">$(VsBundledCMake)</CMakeExe>
	</PropertyGroup>

	<Target Name="RunCMake" BeforeTargets="BeforeBuild" Condition="'$(SkipNativeBuild)' != 'true'">
		<!-- Linux -->
		<Exec Condition="$([MSBuild]::IsOSPlatform('Linux'))"
			  Command="&quot;$(CMakeExe)&quot; -S &quot;$(NativeSourceDir)&quot; -B &quot;$(NativeBuildDir)&quot; -DCMAKE_BUILD_TYPE=$(Configuration)" />
		<Exec Condition="$([MSBuild]::IsOSPlatform('Linux'))"
			  Command="&quot;$(CMakeExe)&quot; --build &quot;$(NativeBuildDir)&quot; --parallel" />

		<!-- Windows: Visual Studio generator -->
		<Exec Condition="$([MSBuild]::IsOSPlatform('Windows'))"
			  Command="&quot;$(CMakeExe)&quot; -S &quot;$(NativeSourceDir)&quot; -B &quot;$(NativeBuildDir)&quot; -A x64" />
		<Exec Condition="$([MSBuild]::IsOSPlatform('Windows'))"
			  Command="&quot;$(CMakeExe)&quot; --build &quot;$(NativeBuildDir)&quot; --config $(Configuration)" />
	</Target>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
		<PackageReference Include="StbImageSharp" Version="2.30.16" />
		<Content Include="TestData/tuck_tuck.jpg">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<PackageReference Include="StbImageWriteSharp" Version="1.16.7" />
	</ItemGroup>

	<ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
		<None Include="$(NativeBuildDir)/libHISPImageProcessing.so" Link="libHISPImageProcessing.so" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>
	<ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
		<None Include="$(NativeBuildDir)/$(Configuration)/HISPImageProcessing.dll" Link="HISPImageProcessing.dll" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>
</Project>
